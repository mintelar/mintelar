# ═══════════════════════════════════════════════════════════
# HARDHAT — Deploy & Verify (solo la wallet admin)
# ═══════════════════════════════════════════════════════════
# Wallet administradora separada. Deployer de ambos contratos.
# NUNCA usar la wallet del backend como admin.
ADMIN_PRIVATE_KEY=
ARBISCAN_API_KEY=

# ═══════════════════════════════════════════════════════════
# SUPABASE (consultas off-chain)
# ═══════════════════════════════════════════════════════════
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_ISSUER=https://your-project.supabase.co/auth/v1
SUPABASE_JWKS_URI=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# ═══════════════════════════════════════════════════════════
# SUPABASE — Backend only (NUNCA en frontend ni en .env del repo)
# ═══════════════════════════════════════════════════════════
# Cargar como Supabase Secret:
#   supabase secrets set SUPABASE_SERVICE_ROLE_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=

# ═══════════════════════════════════════════════════════════
# BLOCKCHAIN — Backend Java only
# ═══════════════════════════════════════════════════════════
ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
HILO_WRAPPER_ADDRESS=
CHAIN_ID=421614

# ═══════════════════════════════════════════════════════════
# WALLET DEL BACKEND — SOLO Supabase Secret
# ═══════════════════════════════════════════════════════════
# Instrucciones de creación en SECURITY.md.
# Cargar como Supabase Secret:
#   supabase secrets set HILO_BACKEND_SIGNER_PRIVATE_KEY=0x...
# NUNCA en el repositorio, .env, logs, ni base de datos.
HILO_BACKEND_SIGNER_PRIVATE_KEY=

# ═══════════════════════════════════════════════════════════
# CONFIGURACIÓN DE RECOMPENSAS
# ═══════════════════════════════════════════════════════════
HILO_REWARD_AMOUNT=10
HILO_DECIMALS=18

# ═══════════════════════════════════════════════════════════
# RATE LIMITING
# ═══════════════════════════════════════════════════════════
RATE_LIMIT_REQUESTS=5
RATE_LIMIT_WINDOW_SECONDS=900
RATE_LIMIT_GROUP_REQUESTS=10
RATE_LIMIT_GROUP_WINDOW_SECONDS=3600

# ═══════════════════════════════════════════════════════════
# CORS
# ═══════════════════════════════════════════════════════════
ALLOWED_ORIGINS=https://your-app.lovable.app
